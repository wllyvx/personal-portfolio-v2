---
import type { Project } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section id="proyek" aria-labelledby="judul-proyek" class="scroll-mt-20 border-b rule">
	<div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
		<SectionHeading left="Hal. 03 · Proyek pilihan" right="5 slot proyek, belum ada yang asli" />
		<h2
			id="judul-proyek"
			class="reveal font-display headline-balance mt-8 leading-[0.95] text-[#f2ead9] uppercase"
			style="font-size: clamp(2.25rem, 5.5vw, 5rem);"
			data-reveal
		>
			Lima proyek, satu gaya visual yang konsisten.
		</h2>
		<p class="reveal mt-5 max-w-[70ch] leading-relaxed text-[#cfc4ae]" data-reveal>
			Setiap entri di bawah ini placeholder berlabel. Struktur datanya sudah
			final: judul, deskripsi, peran, tahun, tautan, dan visual besar, sehingga
			karya asli tinggal menggantikan isinya.
		</p>

		<div class="mt-14 space-y-16 md:space-y-24">
			{projects.map((p, i) => <ProjectCard project={p} index={i} />)}
		</div>
	</div>
</section>
