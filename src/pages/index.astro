---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import EditionStrip from "../components/EditionStrip.astro";
import Profile from "../components/Profile.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import Contact from "../components/Contact.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { projects, stack } from "../data/content";
---

<BaseLayout
	title="Willy Fajar Ramadhan | Website Developer"
	description="Portfolio Willy Fajar Ramadhan, website developer. Edisi satu halaman: profil, proyek pilihan, dan kontak."
>
	<SiteHeader />

	<main id="isi">
		<Hero />
		<EditionStrip />
		<Profile stack={stack} />
		<ProjectsSection projects={projects} />
		<Contact />
	</main>

	<SiteFooter />
</BaseLayout>
